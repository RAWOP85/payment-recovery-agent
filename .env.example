# Razorpay test-mode credentials — Razorpay Dashboard > Settings > API Keys > Generate Test Key
# Test keys always start with rzp_test_. NEVER commit real keys — copy this file to .env.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key powering the recovery agent's diagnosis layer.
# Optional: without it every run cleanly falls back to the deterministic rule
# table and says so in the report — the run still completes and still reports
# honestly. Set it to exercise the real LLM path (at most 4 calls per run, one
# per unique failure_reason).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides for the diagnosis call.
# LLM_MODEL=claude-sonnet-5
# LLM_TIMEOUT_MS=10000
# NOTE: temperature/top_p/top_k are deliberately never sent to the Anthropic
# API here — Claude 5 family models (Sonnet 5, Opus 5, Fable 5) reject them
# with an HTTP 400, they aren't just deprecated-but-tolerated. Don't add a
# TEMPERATURE env var back without checking the model docs first.

# Optional: how long `npm run recover -- --live-wait` polls the generated
# Razorpay Payment Link's status for before giving up (hard cap, ms).
# Defaults to 75000.
# LIVE_WAIT_MS=240000

# Optional: how often `--live-wait` re-checks the Payment Link's status while
# waiting (ms) — it returns as soon as the link is paid, so this is a polling
# cadence, not an extra delay. Defaults to 5000.
# POLL_INTERVAL_MS=5000
