# Razorpay test-mode credentials — Razorpay Dashboard > Settings > API Keys > Generate Test Key
# Test keys always start with rzp_test_. NEVER commit real keys — copy this file to .env.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key powering the recovery agent's diagnosis layer.
# Optional: without it every run cleanly falls back to the deterministic rule
# table and says so in the report — the run still completes and still reports
# honestly. Set it to exercise the real LLM path (at most 4 calls per run, one
# per unique failure_reason).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides for the diagnosis call.
# LLM_MODEL=claude-sonnet-5
# LLM_TIMEOUT_MS=10000

# Optional: how long `npm run recover -- --live-wait` waits for you to pay the
# generated Razorpay Payment Link before checking its status. Defaults to 75000.
# LIVE_WAIT_MS=240000
